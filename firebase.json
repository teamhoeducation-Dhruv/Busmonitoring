{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/master",
        "destination": "/master.html"
      },
      {
        "source": "/district",
        "destination": "/district.html"
      },
      {
        "source": "/school",
        "destination": "/school.html"
      },
      {
        "source": "**",
        "destination": "/login.html"
      }
    ]
  },
  "emulators": {
    "hosting": {
      "host": "127.0.0.1",
      "port": 5000
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
        "enabled": true,
        "host": "127.0.0.1",
        "port": 4000
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
